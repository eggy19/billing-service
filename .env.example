# Application
APP_PORT=3002
NODE_ENV=development
SERVICE_NAME=billing-service

# Database (PostgreSQL) - schema khusus billing
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=klinik
DB_SCHEMA=billing

# Internal JWT dari Gateway (verifikasi EdDSA dengan public key)
JWT_PUBLIC_KEY_PATH=certs/public.pem
JWT_ISSUER=gateway-identity-service
JWT_AUDIENCE=billing-service

# Token service-to-service untuk /billing/internal/* (ganti di environment nyata)
INTERNAL_SERVICE_TOKEN=change-me

# Logging
LOG_LEVEL=info

# CORS (comma-separated). Kosong = izinkan semua origin (khusus dev).
CORS_ORIGINS=
